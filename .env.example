version: '1.0.0'

# 실제 값은 .env.yml (gitignore, 이미지에 굽지 않음)
# 운영 서버에는 /data/fotstat_go/.env.yml 로 두고 compose 가 /root/.env.yml 로 마운트

develop:
  jwtSecret: CHANGE_ME
  database:
    type: mysql
    # 로컬 개발 DB — db/docker-compose.yml (fotstat_mariadb_dev, 127.0.0.1:3310)
    host: 127.0.0.1
    port: 3310
    name: fotstat
    user: fotstat
    password: CHANGE_ME
  mail:
    server: smtp.gmail.com
    port: '587'
    user: your-email@gmail.com
    password: your-email-password
    sender: fotstat <your-email@gmail.com>
  port: 8009
  cors: [http://localhost:9009, http://localhost:5173]
  documentRoot: ./webdata
  path: ./webdata
  apple:
    teamId: CHANGE_ME # Apple Developer Team ID (10자)
    keyId: CHANGE_ME # Sign in with Apple 키의 Key ID (10자)
    clientId: com.gowoobro.fotstat
    privateKeyPath: ./secrets/AuthKey_XXXXXXXXXX.p8

production:
  jwtSecret: CHANGE_ME
  database:
    type: mysql
    host: go_mariadb
    port: 3306
    name: fotstat
    user: fotstat
    password: CHANGE_ME
  mail:
    server: smtp.gmail.com
    port: '587'
    user: your-email@gmail.com
    password: your-email-password
    sender: fotstat <your-email@gmail.com>
  port: 8009
  cors: [https://fotstat.gowoobro.com, http://localhost:5173]
  documentRoot: ./webdata
  path: ./webdata
  apple:
    teamId: CHANGE_ME
    keyId: CHANGE_ME
    clientId: com.gowoobro.fotstat
    privateKeyPath: ./secrets/AuthKey_XXXXXXXXXX.p8
